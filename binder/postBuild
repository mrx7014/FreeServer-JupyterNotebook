#!/usr/bin/env bash
set -e
set -x  # Enable debug mode

# Workaround for Node.js/OpenSSL 3.0 issues
export NODE_OPTIONS=--openssl-legacy-provider

# Log the start of the postBuild process
echo "Starting postBuild process..."

# Install Coursier for Scala kernel installation
echo "Installing Coursier..."
curl -fLo cs https://github.com/coursier/coursier/releases/download/v2.0.3/cs-x86_64-pc-linux
chmod +x cs

# Check if Coursier was downloaded successfully
if [ ! -f "./cs" ]; then
  echo "Error: Coursier download failed."
  exit 1
fi

# Install Almond kernel for Scala 2.13
ALMOND_VERSION=0.11.1
echo "Installing almond for Scala 2.13..."
./cs launch "almond:$ALMOND_VERSION" --scala 2.13.3 -- \
  --install \
  --id scala213 \
  --display-name "Scala (2.13)" \
  --env "JAVA_OPTS=-XX:MaxRAMPercentage=80.0" \
  --variable-inspector \
  </dev/null 2>&1 | tee /tmp/almond-install-2.13.log

# Install Almond kernel for Scala 2.12
echo "Installing almond for Scala 2.12..."
./cs launch "almond:$ALMOND_VERSION" --scala 2.12.12 -- \
  --install \
  --id scala212 \
  --display-name "Scala (2.12)" \
  --env "JAVA_OPTS=-XX:MaxRAMPercentage=80.0" \
  --variable-inspector \
  </dev/null 2>&1 | tee /tmp/almond-install-2.12.log

# Install Almond kernel for Scala 2.11 (almond v0.6.0)
echo "Installing almond for Scala 2.11 (almond v0.6.0)..."
SCALA_VERSION=2.11.12 ALMOND_VERSION=0.6.0
./cs bootstrap \
  -r jitpack \
  -i user -I user:sh.almond:scala-kernel-api_$SCALA_VERSION:$ALMOND_VERSION \
  sh.almond:scala-kernel_$SCALA_VERSION:$ALMOND_VERSION \
  --sources --default=true \
  -o almond-scala-2.11 \
  </dev/null 2>&1 | tee /tmp/almond-install-2.11.log
./almond-scala-2.11 --install --id scala211 --display-name "Scala (2.11)" \
  --command "java -XX:MaxRAMPercentage=80.0 -jar almond-scala-2.11 --id scala211 --display-name 'Scala (2.11)'" \
  --copy-launcher \
  --metabrowse
rm -f almond-scala-2.11

# Install required JupyterLab extensions
echo "Installing JupyterLab extensions..."
echo "ignore-engines true" >> ~/.yarnrc
jupyter labextension install --minimize=False \
  jupyterlab-plotly \
  @almond-sh/scalafmt \
  @almond-sh/jupyterlab_variableinspector || { echo "Error: JupyterLab extension installation failed."; tail -n 50 /tmp/jupyterlab-debug-*.log; exit 1; }

# Set indentation to two spaces for JupyterLab and classic notebook
echo "Configuring Jupyter indentation settings..."
JUPYTER_CONFIG_DIR=$(jupyter --config-dir)

# Ensure the necessary directories exist
mkdir -p $JUPYTER_CONFIG_DIR/nbconfig/
mkdir -p $JUPYTER_CONFIG_DIR/lab/user-settings/@jupyterlab/notebook-extension/
mkdir -p $JUPYTER_CONFIG_DIR/lab/user-settings/@jupyterlab/fileeditor-extension/

# Classic notebook configuration (indentation)
cat > $JUPYTER_CONFIG_DIR/nbconfig/notebook.json <<- EOF
{
  "CodeCell": {
    "cm_config": {
      "indentUnit": 2
    }
  }
}
EOF

# JupyterLab notebook configuration (indentation)
cat > $JUPYTER_CONFIG_DIR/lab/user-settings/@jupyterlab/notebook-extension/tracker.jupyterlab-settings <<- EOF
{
  "codeCellConfig": {
    "tabSize": 2
  }
}
EOF

# JupyterLab editor configuration (indentation)
cat > $JUPYTER_CONFIG_DIR/lab/user-settings/@jupyterlab/fileeditor-extension/plugin.jupyterlab-settings <<- EOF
{
  "editorConfig": {
    "tabSize": 2
  }
}
EOF

# Cloudflare Tunnel setup
echo "Downloading cloudflared..."
mkdir -p "$HOME/.local/bin"
curl -fLo "$HOME/.local/bin/cloudflared" https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64
chmod +x "$HOME/.local/bin/cloudflared"

# Make sure ~/.local/bin is in PATH for future shells
if ! grep -q '.local/bin' "$HOME/.bashrc" 2>/dev/null; then
  echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.bashrc"
fi

# Create a helper script the user runs manually from a Jupyter terminal
mkdir -p "$HOME/.startup"
cat > "$HOME/.startup/start_tunnel.sh" <<- 'EOF'
#!/bin/bash

echo "========================================="
echo "Starting SSH Tunnel with Cloudflare..."
echo "========================================="

# Start SSH server if available (ignored if not installed / no permission)
service ssh start > /dev/null 2>&1 || true

# Start cloudflared tunnel and capture the output
"$HOME/.local/bin/cloudflared" tunnel --url ssh://127.0.0.1:22 > /tmp/tunnel_output.txt 2>&1 &

# Wait for tunnel to be ready and extract the URL
sleep 3

if [ -f /tmp/tunnel_output.txt ]; then
    echo ""
    echo "========================================="
    echo "TUNNEL READY! Use this SSH command:"
    echo "========================================="
    grep -oP 'https://[a-z0-9\-]+\.trycloudflare\.com' /tmp/tunnel_output.txt | head -1 | while read url; do
        echo "SSH URL: $url"
        echo ""
        echo "From your local machine, run:"
        echo "ssh -o ProxyCommand='cloudflared access tcp --hostname $url' root@localhost"
        echo ""
        echo "Keep this terminal open to maintain the tunnel."
        echo "========================================="
    done
else
    echo "Error: Tunnel failed to start"
fi

# Keep the script running so the tunnel stays alive
tail -f /dev/null
EOF

chmod +x "$HOME/.startup/start_tunnel.sh"

echo "Cloudflared installed successfully!"
echo "To start the tunnel later, run in a Jupyter terminal:"
echo "  bash ~/.startup/start_tunnel.sh"

# Log the successful completion of postBuild
echo "postBuild process completed successfully."
